cwf default
import delimited "https://epoch.ai/data/eci_benchmarks.csv", clear

egen _model_id = group(model), label  // make numeric IDs
egen _benchmark_id = group( benchmark), label

fracreg probit performance i.(_model_id _benchmark_id), het(i._benchmark_id)

* extract results
sum _model_id, meanonly
local N_models = r(max)
sum _benchmark_id, meanonly
local N_benchmarks = r(max)

mat myeci   =         e(b)[1,"performance:1._model_id".."performance:`N_models'._model_id"]'
mat myeci_V = vecdiag(e(V)[  "performance:1._model_id".."performance:`N_models'._model_id", "performance:1._model_id".."performance:`N_models'._model_id"])'
mata z = -invnormal((1-.90)/2)
mata st_matrix("myeci_lo", st_matrix("myeci") - z * sqrt(st_matrix("myeci_V")))
mata st_matrix("myeci_hi", st_matrix("myeci") + z * sqrt(st_matrix("myeci_V")))

mat myedi = -e(b)[1,"performance:1._benchmark_id".."performance:`N_benchmarks'._benchmark_id"]'  // (negate difficulties to follow sign convention)

mat myslope = e(b)[1,"lnsigma:"]'
mata st_matrix("myslope", exp(-st_matrix("myslope")))  // fracreg divides by slope parameters rather than multiplying as in the standard IRT 2PL; and parameterizes them in logs

* rescale
local lower_anchor = [performance]_b[`="Claude 3.5 Sonnet":_model_id'._model_id]
local upper_anchor = [performance]_b[`=            "GPT-5":_model_id'._model_id]
local S = (150 - 130) / (`upper_anchor' - `lower_anchor')
mata st_matrix("myeci"   , (st_matrix("myeci"   ) :- `lower_anchor') * `S' :+ 130)
mata st_matrix("myeci_lo", (st_matrix("myeci_lo") :- `lower_anchor') * `S' :+ 130)
mata st_matrix("myeci_hi", (st_matrix("myeci_hi") :- `lower_anchor') * `S' :+ 130)
mata st_matrix("myedi"   , (st_matrix("myedi"   ) :- `lower_anchor') * `S' :+ 130)
mata st_matrix("myslope" ,  st_matrix("myslope" )                    / `S'       )

* scatters of Epoch and fracreg results
gen releasedate = date(date,"YMD")  // convert strings to dates
format %td releasedate

cap frame create official_eci
frame official_eci: import delimited "https://epoch.ai/data/eci_scores.csv", clear
cap frame create official_edi
frame official_edi: import delimited "https://epoch.ai/data/edi_scores.csv", clear

cap frame drop models
frame copy default models
frame models {
  collapse (first) releasedate model_id model, by(_model_id)
  svmat myeci
  svmat myeci_lo
  svmat myeci_hi
  frlink 1:1 model, frame(official_eci)
  frget eci*, from(official_eci)
  gen ciwidth = eci_ci_high - eci_ci_low
  gen myciwidth = myeci_hi1 - myeci_lo1
  scatter myeci1 releasedate, name(eci_vs_releasedate, replace)
  scatter myeci1 eci, aspect(1) xscale(range(0 160)) xlab(0(10)160) ylab(0(10)160) name(eci_check, replace)
  scatter myciwidth ciwidth, aspect(1) xlab(0(10)60) ylab(0(10)60) name(eci_ci_check, replace)
}

cap frame drop benchmarks
frame copy default benchmarks
frame benchmarks {
  frame benchmarks: collapse (first) benchmark_name=benchmark benchmark_id, by(_benchmark_id)
  svmat myedi
  svmat myslope
  frlink 1:1 benchmark_name, frame(official_edi)
  frget edi estimated_slope_scaled, from(official_edi)
  scatter myedi1 edi, aspect(1) xlab(0(50)200) ylab(0(50)200) name(edi_check, replace)
  scatter myslope1 estimated_slope_scaled, aspect(1) xlab(0(.1).3) ylab(0(.1).3, tick) name(myslope_check, replace)
}

----
di exp(-[lnsigma]_b[`="GPQA diamond":_benchmark_id'._benchmark_id]), ///
   exp(-[lnsigma]_b[`="Chess Puzzles":_benchmark_id'._benchmark_id]), ///
   exp(-[lnsigma]_b[`="OTIS Mock AIME 2024-2025":_benchmark_id'._benchmark_id]), ///
   exp(-[lnsigma]_b[`="FrontierMath-Tiers-1-3-v2-Private":_benchmark_id'._benchmark_id])

